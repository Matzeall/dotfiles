# no line numbers, keep header
--style="header,header-filesize,grid,snip"

# theme, see: bat --list-themes
--theme="gruvbox-dark"

# tab display width
--tabs=4

# render italic text themes properly
--italic-text=always

--wrap=auto # or never (in less pager)

# force syntax for files bat can't detect
--map-syntax="*.conf:INI"
--map-syntax=".env:Bash"
--map-syntax="*.ignore:Git Ignore"
--map-syntax="*.service:INI"
--map-syntax="*.timer:INI"
--map-syntax="*.mount:INI"
--map-syntax="*.dockerfile:Dockerfile"
--map-syntax="Dockerfile.*:Dockerfile"
--map-syntax=".dockerignore:Git Ignore"
--map-syntax="Caddyfile:nginx"        # approximation; newest bat has native Caddyfile

--map-syntax="*.ino:C++"              # Arduino
--map-syntax="Jenkinsfile:Groovy"
--map-syntax="*.ipynb:JSON"
--map-syntax=".eslintrc:JSON"
--map-syntax="*.gitconfig.local:Git Config"

--map-syntax="*.zsh*:Bash"            # native since bat 0.26
--map-syntax="*.rasi:CSS"             # rofi themes
--map-syntax="*.vimrc.local:VimL"
